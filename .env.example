# ──────────────────────────────────────────────────────────────
#  StoreMap environment configuration
#  Copy to .env (backend) or paste into your host's env settings.
#  Never commit real secrets.
# ──────────────────────────────────────────────────────────────

# Public origin of the deployment. Used to build OAuth redirect URIs.
# Example: https://map.myshop.com
PUBLIC_BASE_URL=http://localhost:8787

# HTTP port the server listens on.
PORT=8787

# NODE_ENV=production enables Secure cookies and strict checks.
NODE_ENV=

# Random string used to sign session cookies. REQUIRED in production.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_DAYS=30

# Set true when running behind a reverse proxy that terminates TLS.
TRUST_PROXY=false

# ---- Sign in with Google -----------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#   Type: Web application
#   Authorized redirect URI:  {PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Sign in with Apple -------------------------------------------------
# Apple Developer → Identifiers → Register a Services ID (e.g. com.yourco.storemap)
#   Enable "Sign In with Apple" → Configure
#   Return URL:  {PUBLIC_BASE_URL}/api/auth/apple/callback
# Then: Keys → Create a key ("Sign In with Apple") → download the .p8 file.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 private key. Newlines can be written as \n.
APPLE_PRIVATE_KEY=

# ---- Local demo login ---------------------------------------------------
# true allows passwordless test logins at /login without OAuth credentials.
# In production (NODE_ENV=production) this defaults to false.
ENABLE_DEV_LOGIN=

# ---- Self-hosting (local mode) ------------------------------------------
# true marks this instance as self-hosted: paid-tier features (product
# photos) are included for every store, and the first boot with an empty
# database seeds the demo maps. docker-compose.yml defaults this to true.
SELF_HOSTED=

# Set false to skip the demo-map seeding on first boot (default true when
# SELF_HOSTED=true).
SEED_DEMO=

# Storage location for the SQLite database and uploaded images.
# Mount a persistent volume here in production.
DATA_DIR=

# ---- Stage 0 cloud storage / CDN (all optional — see docs/INFRASTRUCTURE.md) ----
# Cloudflare R2: uploaded images (floor plans, logos). Unset = local disk.
# Dashboard → R2 → Create bucket, then "Manage R2 API Tokens" for the keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare CDN: edge-caches public map JSON and purges it per store on edit.
# Dashboard → your zone → Overview (Zone ID) + "Create API Token" with
# permission "Zone → Cache Purge" for your zone.
CF_ZONE_ID=
CF_API_TOKEN=
